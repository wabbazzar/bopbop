# BopBop configuration — lives at ~/.bopbop/env (loaded by the systemd unit).
# `bopbop init` copies this template there; edit the values marked CHANGEME.

# --- Core ------------------------------------------------------------------
# The context dir is the assistant's brain: agent instructions + personality.
BOPBOP_CONTEXT_DIR=~/.bopbop/context
BOPBOP_DATA_DIR=~/.bopbop/data
# Agent harness: claude or codex.
BOPBOP_AGENT_HARNESS=claude
# Claude Code settings (used when BOPBOP_AGENT_HARNESS=claude).
BOPBOP_CLAUDE_BIN=claude
BOPBOP_CLAUDE_MODEL=sonnet
# Codex settings (used when BOPBOP_AGENT_HARNESS=codex). Leave the model
# unset to use the authenticated Codex installation's configured default.
BOPBOP_CODEX_BIN=codex
#BOPBOP_CODEX_MODEL=

# --- Signal channel ----------------------------------------------------------
BOPBOP_SIGNAL_ENABLED=1
SIGNAL_HTTP_URL=http://127.0.0.1:8080
# Your Signal number in E.164 format. CHANGEME.
SIGNAL_ACCOUNT=+15550000000
# Comma-separated allowlist of senders BopBop will answer. Anyone not on
# this list is silently dropped. Usually just your own number. CHANGEME.
SIGNAL_ALLOWED_USERS=+15550000000

# --- HTTP API ----------------------------------------------------------------
# The server binds 127.0.0.1:8090. If you proxy it beyond localhost (e.g.
# Tailscale Serve), the tailnet is your trust boundary. If you expose it
# any wider, REQUIRE the bearer:
BOPBOP_REQUIRE_BEARER=0
#BOPBOP_BEARER_TOKEN=

# --- Optional frontend ---------------------------------------------------------
BOPBOP_PWA_ENABLED=0
