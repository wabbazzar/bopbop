    "@types/node": "^26.6.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.2"
  },
  "overrides": {
    "cookie": "^0.7.2"
